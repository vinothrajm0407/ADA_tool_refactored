# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.

# ── Database (REQUIRED) ──────────────────────────────────────
# Option 1: SQLEXPRESS with SQL login
# MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=ADA_DB;Uid=ada_user;Pwd=yourpassword;Encrypt=no;TrustServerCertificate=yes;
# Option 2: SQLEXPRESS with Windows auth
# MSSQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=ADA_DB;Trusted_Connection=yes;Encrypt=no;TrustServerCertificate=yes;
MSSQL_CONN_STR=
MSSQL_DATABASE=ADA_DB

# ── Redis / Job Queue ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SCAN_QUEUE_NAME=ada_scan_queue
SCAN_WORKER_MAX_WORKERS=2
ALLOW_LOCAL_QUEUE_FALLBACK=true

# ── Scan Timeouts & Retry ────────────────────────────────────
SCAN_TIMEOUT_SECONDS=300
SCAN_JOB_RETRY_MAX=2
SCAN_JOB_RETRY_INTERVALS=15,30
SCAN_JOB_RESULT_TTL=86400
SCAN_JOB_FAILURE_TTL=604800

# ── Crawler Limits ───────────────────────────────────────────
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=1800
CRAWL_MAX_PAGES_FULL=10000
CRAWL_MAX_DEPTH_FULL=10

# ── Email Notifications (crawl completion reports) ───────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_BASE_URL=http://localhost:5000

# ── AI Summary (Anthropic Claude) ────────────────────────────
ANTHROPIC_API_KEY=

# ── Auto-Fix Tier 2 (Gemini, free tier) ───────────────────────
# Get a free key at https://aistudio.google.com/apikey — no card required.
# If omitted, a static placeholder fix is returned instead.
GEMINI_API_KEY=

# ── Application ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
